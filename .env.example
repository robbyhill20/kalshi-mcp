# Obtain production keys from https://kalshi.com/account/profile.
# Ed25519 (recommended) and RSA PEM keys are both supported.
KALSHI_API_KEY_ID=
# Use one quoted string with literal \n separators, or a multiline secret in Render.
KALSHI_PRIVATE_KEY=""
KALSHI_ENV=production
DRY_RUN=true
TRADING_ENABLED=false
REQUIRE_TRADE_APPROVAL=false
MAX_DAILY_ORDER_COST_CENTS=20000

# Four DIFFERENT random secrets, at least 32 characters each.
# Keep ADMIN_TOKEN in your password manager, never in Grok.
ADMIN_TOKEN=
MCP_READ_TOKEN=
MCP_DIRECTOR_TOKEN=
MCP_AXE_TOKEN=

# Axe event-contract caps. Separate from MAX_ORDER_COST_CENTS / MAX_DAILY_ORDER_COST_CENTS.
AXE_MAX_ORDER_COST_CENTS=10000
AXE_MAX_DAILY_ORDER_COST_CENTS=20000
AXE_INDEX_SERIES=KXINX,KXINXU,KXINXPOS,KXNASDAQ100,KXNASDAQ100U,KXDJI

# Margin REST uses the external-api host for KALSHI_ENV. Do not put production keys here for a demo service.
PERPS_ENABLED=false
KALSHI_MARGIN_API_KEY_ID=
KALSHI_MARGIN_PRIVATE_KEY=""
AXE_PERP_SYMBOLS=TSLA,NVDA,AAPL
AXE_PERP_MAX_ORDER_NOTIONAL_CENTS=10000
AXE_PERP_MAX_DAILY_NOTIONAL_CENTS=20000
AXE_PERP_MAX_LEVERAGE=1

# Local testing only. On Render, omit this: RENDER_EXTERNAL_URL is used automatically.
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_PATH=./data/kalshi.sqlite3
# Owner-managed limits. No MCP argument can override these.
MAX_ORDER_COST_CENTS=10000
# Optional additional owner cushion, on top of calculated fees and 1-cent rounding reserve.
FEE_BUFFER_CENTS_PER_CONTRACT=0
SNAPSHOT_MAX_AGE_SECONDS=5
API_TIMEOUT_SECONDS=10
# Exact HTTPS callback hosts; add only the actual official Grok callback host if needed.
OAUTH_REDIRECT_HOSTS=grok.com,accounts.x.ai,console.x.ai
