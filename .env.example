# Obtain production keys from https://kalshi.com/account/profile.
# Ed25519 (recommended) and RSA PEM keys are both supported.
KALSHI_API_KEY_ID=
# Use one quoted string with literal \n separators, or a multiline secret in Render.
KALSHI_PRIVATE_KEY=""
KALSHI_ENV=production
DRY_RUN=true
TRADING_ENABLED=false
REQUIRE_TRADE_APPROVAL=false
MAX_DAILY_ORDER_COST_CENTS=10000

# Three DIFFERENT random secrets, at least 32 characters each.
# Keep ADMIN_TOKEN in your password manager, never in Grok.
ADMIN_TOKEN=
MCP_READ_TOKEN=
MCP_DIRECTOR_TOKEN=

# Local testing only. On Render, omit this: RENDER_EXTERNAL_URL is used automatically.
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_PATH=./data/kalshi.sqlite3
# Owner-managed limits. No MCP argument can override these.
MAX_CONTRACTS=100
MAX_ORDER_COST_CENTS=10000
# Conservative extra reserve, NOT a fee quote. $1 per contract by default.
FEE_BUFFER_CENTS_PER_CONTRACT=100
SNAPSHOT_MAX_AGE_SECONDS=5
API_TIMEOUT_SECONDS=10
# Exact HTTPS callback hosts; add only the actual official Grok callback host if needed.
OAUTH_REDIRECT_HOSTS=grok.com,accounts.x.ai,console.x.ai
